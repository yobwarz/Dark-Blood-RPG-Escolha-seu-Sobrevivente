<div class="ess-selection">{{#if background}}{{#if isVideo}}<video class="ess-background" src="{{background}}" autoplay muted loop playsinline aria-hidden="true"></video>{{else}}<img class="ess-background" src="{{background}}" alt="">{{/if}}{{/if}}<div class="ess-shade" style="opacity:{{overlay}}"></div><main class="ess-main"><header class="ess-gallery-heading"><div><p class="ess-eyebrow">SANGUE ESCURO · UM NOVO GRUPO. UMA NOVA CHANCE.</p><h1>ESCOLHA SEU<br>SOBREVIVENTE</h1><p>Conheça suas histórias. Encontre seu lugar na equipe.</p></div><button class="ess-exit" data-action="escolha" data-op="close">Fechar seleção ×</button></header>{{#if preview}}<p class="ess-preview">PRÉVIA DO MESTRE · Nenhuma escolha ou permissão será alterada.</p>{{else}}{{#unless connected}}<p class="ess-preview">Sem Mestre conectado. Você pode navegar; novas escolhas precisam aguardar.</p>{{/unless}}{{/if}}
{{#if composition}}<div class="ess-composition" aria-label="Composição recomendada">{{#each composition}}<span class="ess-role-pill {{#if covered}}covered{{/if}}">{{#if img}}<img src="{{img}}" alt="">{{/if}}{{name}} <small>{{#if covered}}✓ Coberta{{else}}Faltando{{/if}}</small></span>{{/each}}</div>{{/if}}
<div class="ess-grid-scroll"><div class="ess-grid">{{#each heroes}}<button type="button" class="ess-hero-card {{#if selected}}selected{{/if}} {{#if locked}}locked{{/if}}" data-action="escolha" data-op="pick" data-id="{{id}}" data-hero="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><img class="ess-card-art" src="{{img}}" alt="{{name}}" loading="lazy"><div class="ess-card-roles">{{#each roles}}<span title="{{name}}">{{#if img}}<img src="{{img}}" alt="{{name}}">{{else}}{{name}}{{/if}}</span>{{/each}}</div><div class="ess-card-caption"><h2>{{name}}</h2>{{#if busy}}<small>Alteração em conferência</small>{{else}}{{#if own}}<small>Seu sobrevivente</small>{{else}}{{#if ownerName}}<small>Reservado · {{ownerName}}</small>{{else}}<small>Disponível para escolha</small>{{/if}}{{/if}}{{/if}}</div>{{#if interests}}<div class="ess-interests" title="Jogadores interessados; ainda não é uma reserva">{{#each interests}}<span>{{name}}</span>{{/each}}</div>{{/if}}</button>{{else}}{{#unless showCreator}}<div class="ess-empty"><h2>Nenhum sobrevivente disponível.</h2><p>O Mestre ainda está preparando o elenco.</p></div>{{/unless}}{{/each}}{{#if showCreator}}<button type="button" class="ess-hero-card ess-create-card" data-action="escolha" data-op="create" aria-label="Crie o seu próprio sobrevivente"><span class="ess-create-icon" aria-hidden="true"><i class="fas fa-user-plus"></i></span><span class="ess-create-title">Crie o seu próprio</span><span class="ess-create-note">Abrir Criador de Sobrevivente</span></button>{{/if}}</div></div><footer class="ess-gallery-note">O interesse não reserva um personagem. A primeira confirmação válida fica com ele.</footer></main>
{{#if selected}}<aside class="ess-details"><header class="ess-actions"><button data-action="escolha" data-op="back">← Galeria</button>{{#if canInspect}}<button data-action="escolha" data-op="sheet">Ver ficha completa</button>{{/if}}</header><img class="ess-detail-art" src="{{selected.detail}}" alt="{{selected.name}}"><div class="ess-detail-copy"><p class="ess-eyebrow">{{#if selected.own}}SEU SOBREVIVENTE{{else}}CONHEÇA SUA HISTÓRIA{{/if}}</p><h2>{{selected.name}}</h2><div class="ess-detail-roles">{{#each selected.roles}}<span class="ess-role-pill">{{#if img}}<img src="{{img}}" alt="">{{/if}}{{name}}</span>{{/each}}</div><div class="ess-description">{{{selected.html}}}</div>{{#if canClaim}}<button class="ess-primary ess-claim" data-action="escolha" data-op="claim">Escolher este sobrevivente</button>{{/if}}{{#if canRelease}}<button class="ess-release" data-action="escolha" data-op="release">Liberar sobrevivente</button>{{/if}}{{#if working}}<p role="status">Aguardando confirmação da operação…</p>{{/if}}{{#if selected.locked}}<p>Este sobrevivente está reservado ou em conferência.</p>{{/if}}</div></aside>{{/if}}</div>
